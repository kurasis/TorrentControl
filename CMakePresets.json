{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "TC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows MSVC ASan with prebuilt release dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "$env{TC_DEPS_PREFIX}",
        "TC_WARNINGS_AS_ERRORS": "ON",
        "TC_ENABLE_SANITIZERS": "ON",
        "TC_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (headless core)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (headless core)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-prebuilt-deps",
      "displayName": "Linux Debug with dependencies from TC_DEPS_PREFIX (no vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{TC_DEPS_PREFIX}",
        "TC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux ASan + UBSan with prebuilt dependencies",
      "inherits": "linux-prebuilt-deps",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "TC_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux Clang libFuzzer + ASan + UBSan",
      "inherits": "linux-sanitizers",
      "cacheVariables": { "TC_BUILD_FUZZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "windows-asan", "configurePreset": "windows-asan" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-prebuilt-deps", "configurePreset": "linux-prebuilt-deps" },
    { "name": "linux-sanitizers", "configurePreset": "linux-sanitizers" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" }
  ],
  "testPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "output": { "outputOnFailure": true } },
    { "name": "windows-asan", "configurePreset": "windows-asan", "output": { "outputOnFailure": true } },
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-prebuilt-deps", "configurePreset": "linux-prebuilt-deps", "output": { "outputOnFailure": true } },
    { "name": "linux-sanitizers", "configurePreset": "linux-sanitizers", "output": { "outputOnFailure": true } },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz", "output": { "outputOnFailure": true } }
  ]
}
